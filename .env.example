# TradePilot AI — environment variable reference.
#
# Copy to .env for local overrides (gitignored) or set these directly in your
# deployment platform's environment settings (e.g. Render's dashboard). None
# are required — every one has a safe default matching current local/Windows
# behaviour exactly, so an unset variable changes nothing.

# Relocates data_store/ (both market.db and market_v2.db) as a whole — e.g.
# to a persistent disk mount point on a paid Render plan. NOT used by the
# current Render Free deployment (see DEPLOYMENT.md) — that pattern ships
# the two .db files via git and relies on this staying unset, so they land
# at the default path below (where `git checkout` puts them).
# Default: <project root>/data_store
# MID_DATA_DIR=/var/data/tradepilot

# Relocates logs/ as a whole. Default: <project root>/logs
# MID_LOGS_DIR=/var/data/tradepilot/logs

# Full SQLAlchemy URL for V1's database — overrides MID_DATA_DIR for V1 only,
# useful if V1 ever moves off SQLite (e.g. to Postgres). V2 remains SQLite-only
# by design (see intelligence_v2/database/v1_reference.py's read-only bridge).
# Default: sqlite:///<MID_DATA_DIR>/market.db
# MID_DATABASE_URL=sqlite:////var/data/tradepilot/market.db

# 1 = skip live NSE/BSE/yfinance fetches, use deterministic seeded data
# (always reproducible, no network/credentials needed). 0 = attempt live
# fetches, falling back to seed data only on failure. Default: 1
# MID_OFFLINE=1

# 1 = start the in-process daily-refresh scheduler (scheduler.py) alongside
# the dashboard, in this same process/service/disk. 0/unset = scheduler
# never starts — identical behaviour to every prior version of this app.
# Default: 0
# MID_ENABLE_SCHEDULER=1

# UTC time-of-day ("HH:MM") the scheduler runs the daily refresh at, only
# relevant when MID_ENABLE_SCHEDULER=1. Default: 14:30 (= 20:00 IST, matching
# the existing local Windows Task Scheduler's schedule).
# MID_SCHEDULER_UTC_TIME=14:30
